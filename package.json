{
  "name": "lockform-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted relay that decrypts Lockform submissions with your own key and fans them out to your integrations. Lockform never holds your key or your integration secrets.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/smoke.ts && tsx tests/e2e.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.8.1",
    "hono": "^4.6.14",
    "lockform": "^4.1.0",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3"
  }
}
