# ─── Required ──────────────────────────────────────────────────────────────

# Your Lockform private key(s), base64, comma-separated if you have more than one
# (e.g. after rotating a key). Derive it from your 15-word passphrase with:
#   npx lockform-derive-key
# The relay tries each key until one decrypts the submission.
# NEVER use the 15-word passphrase here directly - deriving it at runtime is slow
# and will time out. Always paste the base64 key.
LOCKFORM_PRIVATE_KEYS=

# Shared secret used to verify that incoming webhooks really came from Lockform.
# Generate a random one (e.g. `openssl rand -hex 32`) and paste the SAME value
# into Lockform when you connect this relay.
WEBHOOK_SECRET=

# Password that protects the relay's config UI/API. You enter this in Lockform
# to manage integrations. It also encrypts your integration secrets at rest, so
# if you change it you must re-enter every integration secret.
ADMIN_PASSWORD=

# ─── Optional ──────────────────────────────────────────────────────────────

# Browser origins allowed to call the admin API (comma-separated).
# Defaults to the Lockform app. Add http://localhost:5173 for local UI dev.
ALLOWED_ORIGINS=https://app.lockform.io

# Where the SQLite database lives. On Railway, attach a Volume and point this at
# its mount path so config survives redeploys, e.g. /data/relay.sqlite
DB_PATH=./data/relay.sqlite

# Port the relay listens on (Railway sets PORT automatically).
PORT=8080
